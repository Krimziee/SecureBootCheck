<!--
    Standalone Secure Boot & TPM 2.0 Check window: an empty frame that shows
    Page.xaml. (In Krimz's Toolkit the same page is shown in the Secure Boot tab.)
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Boot &amp; TPM 2.0 Check" Width="1100" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
</Window>
