<!--
    Secure Boot & TPM 2.0 Check page. Used by the standalone window
    (MainWindow.xaml) and by the Secure Boot tab in Krimz's Toolkit.
    Left: your PC and one card per check. Right: the verdict and, when
    something is wrong, what to do. Filled in by modules\Ui.ps1.
    Styles come from Theme.xaml (loaded as the application's resources).
-->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}" Foreground="#F3F3F3"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" MinHeight="540">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Secure Boot &amp; TPM 2.0" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
                <Border Background="#1F3A26" CornerRadius="4" Padding="8,2" Margin="12,0,0,4" VerticalAlignment="Bottom">
                    <TextBlock Text="Read-only: changes nothing on your PC" Foreground="#6CCB5F" FontSize="12"/>
                </Border>
            </StackPanel>
            <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Checks whether Secure Boot and TPM 2.0 are set up the way games with anti-cheat need them, and if not, exactly why."/>
        </StackPanel>

        <!-- ============================ Results ============================ -->
        <Grid x:Name="ResultPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="YOUR PC" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel x:Name="PcInfoPanel"/>
                    </Border>
                    <TextBlock Text="WHAT WAS CHECKED" Style="{StaticResource Label}"/>
                    <StackPanel x:Name="ChecksPanel"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RESULT" Style="{StaticResource Label}"/>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ResultBadge" Width="52" Height="52" CornerRadius="26" Background="#1F3A26" VerticalAlignment="Top">
                            <TextBlock x:Name="ResultIcon" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="#6CCB5F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ResultSubtitle" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <WrapPanel x:Name="ChipsPanel" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel x:Name="AdvicePanel" Margin="0,0,6,0"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================ Checking ============================ -->
        <StackPanel x:Name="CheckingPage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
            <TextBlock Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
            <TextBlock x:Name="CheckingTitle" Text="Checking your PC..." FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock x:Name="CheckingText" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       Text="Reading the firmware settings, the TPM and the disk layout. This takes a few seconds and changes nothing."/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <Button x:Name="CheckButton" Grid.Column="1" Style="{StaticResource AccentButton}" Content="Check again" MinWidth="140" IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
